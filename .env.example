# Copy to .env for local use. Existing environment variables take precedence.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: use the actual HTTPS origin(s), comma separated.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional absolute path on durable storage. Defaults to ./db.sqlite3.
# DJANGO_DB_PATH=/path/to/private/data/books.sqlite3
# Optional password only when creating the local demo account.
# DEMO_PASSWORD=choose-a-strong-local-password

# PostgreSQL (optional). Omit or leave empty to use SQLite.
DATABASE_URL=
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# On Vercel, set DATABASE_URL and DJANGO_SECRET_KEY in Project Settings.
# DEBUG is forced off. Exact Vercel deployment hosts are recognized automatically.
# Set DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS for custom domains.

# Optional WhatsApp Sandbox integration. See docs/WHATSAPP.md.
WHATSAPP_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=
OPENAI_API_KEY=
OPENAI_BOOKKEEPING_MODEL=gpt-5.4-mini

BOOKKEEPING_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BOOKKEEPING_MODEL=openai/gpt-oss-20b
# Dedicated phone-link signing secret, identical on web and worker.
WHATSAPP_LINK_SECRET=
