USSD_PORT=8080
SPRING_PROFILES_ACTIVE=dev
REDIS_PASSWORD=generate-a-random-password
GATEWAY_KEY=generate-at-least-24-random-characters
STATE_SECRET=generate-at-least-32-random-characters
AUTH_PUBLIC_URL=https://4tax-auth.vercel.app
AUTH_URL=https://4tax-auth.vercel.app
AUTH_ISSUER=https://4tax-auth.vercel.app
AUTH_JWKS_URL=https://4tax-auth.vercel.app/oauth2/jwks
REGISTRATION_URL=https://4tax.vercel.app
BACKEND_CONNECT_TIMEOUT=5s
BACKEND_REQUEST_TIMEOUT=30s
# Returned by POST /api/v1/clients on the auth service.
USSD_CLIENT_ID=issued-by-auth
USSD_CLIENT_SECRET=issued-by-auth

# Hosted Redis TLS (e.g. Upstash):
REDIS_USERNAME=default
REDIS_SSL=false
